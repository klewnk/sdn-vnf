sh echo "===== Basic connectivity ====="
h1 ping -c 2 10.0.0.100
h1 ping -c 2 10.0.0.10
h1 ping -c 2 10.0.0.11

sh echo "===== DNS tests ====="
h1 nslookup google.com 10.0.0.100
h1 nslookup phishing.test 10.0.0.100
h1 nslookup malware.test 10.0.0.100

sh echo "===== FRR Router inter-subnet test ====="
h1 ping -c 3 10.0.1.3

sh echo "===== Proxy direct block test ====="
h1 curl -s -o /dev/null -w "proxy block 1: %{http_code}\n" -x http://10.0.0.10:3128 http://facebook.com
h1 curl -s -o /dev/null -w "proxy block 2: %{http_code}\n" -x http://10.0.0.10:3128 http://facebook.com
h1 curl -s -o /dev/null -w "proxy block 3: %{http_code}\n" -x http://10.0.0.10:3128 http://facebook.com

sh echo "===== WAF normal vs attack tests ====="
h1 curl -s -o /dev/null -w "waf normal: %{http_code}\n" "http://10.0.0.11:8080/?id=123"
h1 curl -s -o /dev/null -w "waf sql injection: %{http_code}\n" "http://10.0.0.11:8080/?id=1%27%20OR%20%271%27%3D%271"
h1 curl -s -o /dev/null -w "waf xss: %{http_code}\n" "http://10.0.0.11:8080/?q=%3Cscript%3Ealert(1)%3C/script%3E"

sh echo "===== Load balancer visible backend test ====="
h1 curl -s http://10.0.0.8/
h1 curl -s http://10.0.0.8/
h1 curl -s http://10.0.0.8/

sh echo "===== Edge cache HIT/MISS test ====="
h1 curl -s -o /dev/null -w "cache first request: status=%{http_code} time=%{time_total}\n" http://10.0.0.30/bigfile.dat
h1 curl -s -o /dev/null -w "cache second request: status=%{http_code} time=%{time_total}\n" http://10.0.0.30/bigfile.dat
sh docker logs --tail 5 vnf_cache

sh echo "===== NAT outbound chain test ====="
h1 curl -s -o /dev/null -w "nat outbound: %{http_code}\n" --max-time 10 http://example.com
sh docker exec vnf_nat iptables -t nat -L POSTROUTING -v -n

sh echo "===== Firewall policy check ====="
sh docker exec vnf_firewall iptables -S
sh docker exec vnf_firewall iptables -L FORWARD -v -n

sh echo "===== Traffic Control QoS check ====="
sh docker exec vnf_tc tc -s qdisc show dev eth1
h1 curl -s -o /dev/null --max-time 10 http://example.com
sh docker exec vnf_tc tc -s class show dev eth1

sh echo "===== IDS recent alerts ====="
sh docker logs --tail 20 vnf_ids
